# Backend Environment Variables

# Django API Configuration
DJANGO_SECRET_KEY=replace_with_a_long_random_secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Server sau Nginx (để trống khi chạy local)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://qlvb.example.vn
# DJANGO_SECURE_PROXY_SSL_HEADER=true
# DJANGO_SECURE_SSL_REDIRECT=false
# DJANGO_SECURE_COOKIES=true
# DJANGO_SECURE_HSTS_SECONDS=0
# Thư mục dùng chung ngoài thư mục release
# DJANGO_MEDIA_ROOT=/srv/qlvb/shared/media
# AI_DATA_DIR=/srv/qlvb/shared/data
# SIGNING_DOCUMENT_ROOT=/srv/qlvb/shared/signing

# Local PostgreSQL 16 from the root Docker Compose setup
DB_ENGINE=postgresql
DB_NAME=qlvb_dev
DB_USER=qlvb_dev
DB_PASSWORD=qlvb_local_only
DB_HOST=127.0.0.1
DB_PORT=55432
DB_CONN_MAX_AGE=60

# Read-only database credentials for AI Chatbox SQL queries (Khuyến nghị môi trường Production)
# Sử dụng tài khoản CSDL chỉ đọc giúp loại trừ hoàn toàn nguy cơ sửa đổi dữ liệu và rò rỉ
DB_READONLY_USER=qlvb_readonly
DB_READONLY_PASSWORD=your_secure_readonly_password
DB_READONLY_NAME=qlvb_tlbm
DB_READONLY_HOST=127.0.0.1
DB_READONLY_PORT=5432

# Absolute root containing the paths/keys stored in SQL file_dinh_kem
QLVB_STORAGE_ROOT=./data/docs


# AI Provider Configuration (gemini or openai)
MODEL_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
EMBED_MODEL=models/gemini-embedding-001
LLM_MODEL=gemini-3.8-flash
VISION_MODEL=gemini-3.8-flash

# ChromaDB Configuration
CHROMA_DB_PATH=./data/chroma_db

# RAG Configuration
SIMILARITY_TOP_K=6
CHUNK_SIZE=512
CHUNK_OVERLAP=80

# Vision OCR tuning (lower = faster)
VISION_OCR_MODE=fallback
VISION_OCR_PDF_DPI=150
VISION_OCR_MAX_IMAGE_SIZE=1024
VISION_OCR_JPEG_QUALITY=90
VISION_OCR_PARALLEL_WORKERS=3

# Sao chép thành .env ở thư mục gốc (không commit). Mọi biến đều tùy chọn khi chạy local.
# Các lệnh `pnpm runserver|manage|test:backend|db:*` tự đặt kết nối PostgreSQL local
# (DJANGO_SECRET_KEY, DJANGO_DEBUG, DJANGO_ALLOWED_HOSTS, DB_*); các biến này trong .env bị bỏ qua.
# Đổi cổng DB/pgAdmin local (khi trùng cổng): đặt trong môi trường shell, không đặt trong file này.
#   QLVB_DB_PORT (mặc định 55432), QLVB_PGADMIN_PORT (mặc định 5050)

# --- AI Chatbox ---
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
EMBED_MODEL=models/gemini-embedding-001
LLM_MODEL=gemini-3.8-flash
VISION_MODEL=gemini-3.8-flash
# Vision OCR (thấp hơn = nhanh hơn)
VISION_OCR_MODE=fallback
VISION_OCR_PDF_DPI=150
VISION_OCR_MAX_IMAGE_SIZE=1024
VISION_OCR_JPEG_QUALITY=90
VISION_OCR_PARALLEL_WORKERS=3

# --- AI SQL, kết nối chỉ đọc (tùy chọn) ---
# Chỉ cần khi chạy truy vấn AI trên dữ liệu văn bản: role riêng (vd. qlvb_readonly) tạo ngoài DDL, chỉ có SELECT trên
# các view ai_*. Không đặt DB_READONLY_USER thì AI SQL từ chối truy vấn; các chức năng khác không bị ảnh hưởng.
# DB_READONLY_NAME/HOST/PORT bỏ trống thì dùng DB_NAME/DB_HOST/DB_PORT. Không bao giờ dùng DB_USER làm role chỉ đọc.
# DB_READONLY_USER=
# DB_READONLY_PASSWORD=
# DB_READONLY_NAME=
# DB_READONLY_HOST=
# DB_READONLY_PORT=

# --- Email CBNV: chỉ nhận tên miền công ty (phân tách bằng dấu phẩy, để rỗng thì không giới hạn) ---
EMPLOYEE_EMAIL_ALLOWED_DOMAINS=baolong.vn

# --- Email sinh nhật (để trống EMAIL_HOST thì in ra console) ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Địa chỉ người gửi, bắt buộc khi đặt EMAIL_HOST (trống thì mọi thư SMTP lỗi "Invalid address ''"). Giữ dấu nháy:
# tệp env trên máy chủ được nạp bằng bash (`set -a; . backend.env`).
DEFAULT_FROM_EMAIL="Hệ thống QLVB <qlvb@baohiembaolong.vn>"
BRAND_NAME=Bảo Long Insurance
ORGANIZATION_NAME=Bảo Long Insurance
# Override URL trang thiệp; mặc định dùng SIGNING_FRONTEND_URL/birthday-card.html.
# Không dùng localhost trên môi trường chia sẻ.
# BIRTHDAY_CARD_BASE_URL=http://localhost:5173/birthday-card.html

# --- Tệp nghiệp vụ (văn bản đến/đi, công việc, biểu mẫu) ---
# Local (DJANGO_DEBUG=true): để trống thì dùng thư mục storage/ cạnh backend (đã gitignore).
# Staging/production: bắt buộc là thư mục tuyệt đối đã tồn tại, ngoài thư mục release, user chạy service ghi được.
DOCUMENT_STORAGE_ROOT=

# --- Trình ký ---
SIGNING_DOCUMENT_ROOT=
SIGNING_PIN_SECRET=
# SMS OTP mặc định để tạo/khôi phục PIN ký. Giá trị thật chỉ cấu hình trong secret store của môi trường.
SIGNING_SMS_URL=
SIGNING_SMS_AUTHORIZATION=
SIGNING_SMS_FROM=
# Upstash TCP broker for Celery; use the TLS endpoint/token, never the REST credentials.
# REDIS_URL=rediss://default:<url-encoded-token>@<tcp-host>:6379?ssl_cert_reqs=required
# Địa chỉ giao diện dùng trong liên kết email (xem, ký). Staging/production: đặt URL giao diện thật, không dùng localhost.
SIGNING_FRONTEND_URL=http://localhost:5173
# Staging: SIGNING_FRONTEND_URL=https://staging-quanlyvanban.bhbl.vn:8088

# --- Chỉ dùng trên server (staging/production), để trống khi chạy local ---
# Staging: DJANGO_CSRF_TRUSTED_ORIGINS=https://staging-quanlyvanban.bhbl.vn:8088,http://127.0.0.1:8088
# Production: DJANGO_CSRF_TRUSTED_ORIGINS=https://qlvb.example.vn
# DJANGO_SECURE_PROXY_SSL_HEADER=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_COOKIES=true
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_MEDIA_ROOT=/srv/qlvb/shared/media
# AI_DATA_DIR=/srv/qlvb/shared/data

# PostgreSQL client used by the Records release tools
# PSYCOPG_IMPL=binary
# Windows example: POSTGRES_BIN=D:/PostgreSQL/bin

# Xác thực kép qua API Bảo Long (Alpaca / BHBL): khóa MAC cấp riêng cho từng môi trường, không đặt mặc định trong mã nguồn
# ALPACA_SECRET_KEY=
# ALPACA_CHECK_AUTH_URL=https://api2.bhbl.vn/auth-command/public/user/check-auth-user
# ALPACA_CHECK_USER_URL=https://api2.bhbl.vn/auth-command/public/user/check-user-exist
# ALPACA_GET_USER_INFO_URL=https://api2.bhbl.vn/auth-command/public/user/get-info-user
# ALPACA_BEARER_AUTH_KEY=
